# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (Vercel URL, localhost, etc.)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# PostgreSQL — Render's managed Postgres gives you this as one connection string.
# Example: postgres://user:password@host:5432/seatflow
DATABASE_URL=postgres://user:password@localhost:5432/seatflow
# Render's managed Postgres requires SSL; leave true in production.
DATABASE_SSL=true

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Never put Stripe secret keys, Supabase service-role keys, or AI provider
# keys in the frontend. They belong here, on the backend, only.
STRIPE_SECRET_KEY=
CLAUDE_API_KEY=
